{
  "name": "codename-siena",
  "version": "0.0.0",
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/ng",
    "start": "nx serve siena",
    "build": "nx build siena",
    "watch": "nx build siena --watch --configuration development",
    "test": "nx test siena",
    "lint": "nx lint siena",
    "watch-map-core": "nx run ngx-map-core:build --watch",
    "watch-isochrone-layer": "nx run ngx-map-isochrone-layer:build --watch",
    "watch-weather-layer": "nx run ngx-map-weather-layer:build --watch",
    "prepare": "rm -rf ./.husky && husky && echo \"npm run precommit\" > .husky/pre-commit",
    "precommit": "lint-staged",
    "start-srp": "nx serve siena-report-public --port=4200",
    "start-sri": "nx serve siena-report-internal --port=4202",
    "start:real-estate-api": "nx serve api",
    "build:real-estate-api": "nx build api",
    "test:real-estate-api": "nx test api",
    "lint:real-estate-api": "nx lint api",
    "migrate:real-estate": "nx run api:migrate",
    "migrate:undo:real-estate": "nx run api:migrate:undo",
    "seed:real-estate": "nx run api:seed"
  },
  "private": true,
