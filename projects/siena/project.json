{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "siena",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "sourceRoot": "projects/siena/src",
  "prefix": "sin",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "outputPath": "dist/siena",
        "index": "projects/siena/src/index.html",
        "browser": "projects/siena/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "projects/siena/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "projects/siena/src/favicon.png",
          "projects/siena/src/assets"
        ],
        "styles": [
          "@angular/material/prebuilt-themes/indigo-pink.css",
          "node_modules/ol/ol.css",
          "node_modules/maplibre-gl/dist/maplibre-gl.css",
          "projects/siena/src/angular-material-styles.scss",
          "projects/siena/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "projects/siena/src/environments/environment.ts",
              "with": "projects/siena/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "projects/siena/src/environments/environment.ts",
              "with": "projects/siena/src/environments/environment.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "proxyConfig": "projects/siena/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "siena:build:production"
        },
        "development": {
          "buildTarget": "siena:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "siena:build"
      }
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "polyfills": [
          "zone.js",
          "zone.js/testing"
        ],
        "tsConfig": "projects/siena/tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "projects/siena/src/favicon.png",
          "projects/siena/src/assets"
        ],
        "styles": [
          "@angular/material/prebuilt-themes/indigo-pink.css",
          "projects/siena/src/styles.scss"
        ],
        "scripts": []
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "projects/siena/**/*.ts",
          "projects/siena/**/*.html"
        ]
      },
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}