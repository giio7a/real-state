{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@nidiro/ngx-map-core": {
      "projectType": "library",
      "root": "projects/nidiro/ngx-map-core",
      "sourceRoot": "projects/nidiro/ngx-map-core/src",
      "prefix": "nid",
      "schematics": {
        "@schematics/angular:component": {
          "skipTests": true,
          "style": "scss"
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/nidiro/ngx-map-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nidiro/ngx-map-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nidiro/ngx-map-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/nidiro/ngx-map-core/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "siena": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/siena",
      "sourceRoot": "projects/siena/src",
      "prefix": "sin",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/siena",
            "index": "projects/siena/src/index.html",
            "browser": "projects/siena/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/siena/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/siena/src/favicon.ico",
              "projects/siena/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/ol/ol.css",
              "node_modules/maplibre-gl/dist/maplibre-gl.css",
              "projects/siena/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "siena:build:production"
            },
            "development": {
              "buildTarget": "siena:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "siena:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/siena/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/siena/src/favicon.ico",
              "projects/siena/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/siena/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "@nidiro/ngx-map-weather-layer": {
      "projectType": "library",
      "root": "projects/nidiro/ngx-map-weather-layer",
      "sourceRoot": "projects/nidiro/ngx-map-weather-layer/src",
      "prefix": "nid",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/nidiro/ngx-map-weather-layer/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nidiro/ngx-map-weather-layer/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nidiro/ngx-map-weather-layer/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/nidiro/ngx-map-weather-layer/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}
