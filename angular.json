{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@nidiro/ngx-map-core": {
      "projectType": "library",
      "root": "projects/nidiro/ngx-map-core",
      "sourceRoot": "projects/nidiro/ngx-map-core/src",
      "prefix": "nid",
      "schematics": {
        "@schematics/angular:component": {
          "skipTests": true,
          "style": "scss"
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/nidiro/ngx-map-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nidiro/ngx-map-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nidiro/ngx-map-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/nidiro/ngx-map-core/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}
